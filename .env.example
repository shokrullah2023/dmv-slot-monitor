# Copy to .env and adjust. Every value here is optional — these are the defaults.

# Your private ntfy topic (pick any hard-to-guess name, e.g. co-dmv-<random>).
# Subscribe to this exact topic in the ntfy phone app. REQUIRED.
NTFY_TOPIC=
# NTFY_URL=https://ntfy.sh
# NTFY_TOKEN=            # only for self-hosted ntfy with auth

# Offices to watch (comma-separated ids):
#   44=Westminster  81=Adams(Westminster/Pecos)  12=Denver NE
#   91=Denver Regional Service Center  10=Aurora  14=Centennial
#   29=Loveland  85=Boulder  92=Longmont  13=Golden  20=Parker
OFFICE_IDS=44,12,10,14,29

# Alert when an open date is between MIN_DAYS and MAX_DAYS from today.
MIN_DAYS=1
MAX_DAYS=7

# Seconds between polling cycles (each cycle checks every office once).
POLL_SECONDS=300

# Daily "I'm alive" push at this hour (America/Denver). Set -1 to disable.
HEARTBEAT_HOUR=9
